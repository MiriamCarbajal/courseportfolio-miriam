*{ box siding: border-box;}
body {
    font-family: Times New Roman, Century Gothic;
    background-color:#48CAE4
    margin: 0;
    padding: 40px 40px;
}

.card{
    max-width: 600px;
    margin: 0 auto;
    padding: 22px;
    background-color: #131E3A;
    border: 2px solid white;
}

.card h1{
    color: white;
    font-size: 16px;
    margin: 2px;
}

.card p{
    color: white;
    font-size: 12px;
    margin: 2px;
}
